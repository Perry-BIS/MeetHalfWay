MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here
TAVILY_API_KEY=your_tavily_key_here
# Yelp Fusion is largely closed to new sign-ups since 2024; leave blank to skip.
YELP_API_KEY=
# Foursquare Places API (https://foursquare.com/developers/) — primary POI source.
FOURSQUARE_API_KEY=your_foursquare_key_here
OPENAI_API_KEY=your_openai_key_here
OPENAI_API_BASE=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.3-70b-versatile

# Optional: SMTP for sending room invites directly from the app.
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
# and put the 16-char password (no spaces) in SMTP_PASSWORD. Leave blank to disable in-app send
# (the "Open in my email client" mailto button still works without these).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
